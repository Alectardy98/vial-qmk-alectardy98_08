+    /* Called only with scheduler/PC interrupts unlocked, host IRQ sources
+     * masked and startup not yet published. Same1ms/50-attempt sequence as
+     * original08036C00; unlike stock, never configure a failed transition. */
+    for(unsigned attempts=0;attempts<50;attempts++){
+        if(!my2k_usbh_delay_cycles(STM32_HCLK/1000u))return 2048u;
+        if(host->otg->GINTSTS&GINTSTS_CMOD)return 0;
+    }
+    return 1024u;
+}
+#endif
+#endif
